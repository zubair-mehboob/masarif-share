{
  "name": "masarif-share",
  "version": "1.0.0",
  "private": true,
  "description": "Holds encrypted Masarif grocery lists while a shopkeeper fills them in.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute masarif-share --local --file=schema.sql",
    "db:remote": "wrangler d1 execute masarif-share --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.148.0"
  }
}
